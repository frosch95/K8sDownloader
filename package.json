{
  "name": "k8sdownloader",
  "version": "1.1.0",
  "description": "Desktop app to browse and download files from Kubernetes pods",
  "author": "Andreas Billmann <abi@love2co.de>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "pnpm generate-licenses && tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "generate-licenses": "generate-license-file --input package.json --output THIRD-PARTY-LICENSES.txt --overwrite",
    "electron:build": "pnpm build && electron-builder",
    "electron:start": "electron .",
    "start": "pnpm build && pnpm electron:start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "generate-license-file": "^4.2.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.k8sdownloader.app",
    "productName": "K8sDownloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "THIRD-PARTY-LICENSES.txt"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "maintainer": "abi@love2co.de"
    }
  }
}