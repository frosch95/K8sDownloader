+  managedBy: "Deployment/nginx",
+  containers: [
+    { name: "nginx", image: "nginx:1.25", ready: true, restartCount: 0, state: "Running" },
+    { name: "sidecar", image: "envoy:1.28", ready: false, restartCount: 3, state: "Waiting: CrashLoopBackOff" },
